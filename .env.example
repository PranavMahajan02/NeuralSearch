# CogniSeek configuration. Copy to .env, then fill the secrets:
#   cp .env.example .env
#   python scripts/generate_secrets.py      # fills every empty REQUIRED secret; prints names only
# .env is git-ignored; never commit it.
#
# REQUIRED  = the Docker deployment (docker-compose.yml) refuses to start without it.
# Settings marked [docker] are only read by docker-compose.yml; [dev] only by the
# non-Docker development setup (backend on :8000, Vite on :3000).

# ============================================================================
# Secrets (generate with scripts/generate_secrets.py)
# ============================================================================

# REQUIRED. JWT signing key, at least 32 random characters.
JWT_SECRET_KEY=
# REQUIRED. Fernet key that encrypts OAuth tokens stored in the DB.
TOKEN_ENCRYPTION_KEY=
# REQUIRED [docker]. Password of the application DB role (not a superuser).
POSTGRES_PASSWORD=
# REQUIRED [docker]. Password of the Postgres bootstrap superuser (init + backups only).
POSTGRES_SUPERUSER_PASSWORD=
# REQUIRED [docker]. Qdrant API key (also required by the backend when ENV=production).
QDRANT_API_KEY=
# REQUIRED [docker]. Redis password (rate-limit storage).
REDIS_PASSWORD=
# REQUIRED for scripts/backup.py. Fernet key that encrypts backups. Store a copy
# OUTSIDE this machine: without it the backups cannot be restored.
BACKUP_ENCRYPTION_KEY=

# ============================================================================
# Deployment [docker]
# ============================================================================

# Public host name. "localhost" = HTTPS with Caddy's internal (self-signed) CA.
# A real domain gets a Let's Encrypt certificate; then set TLS to your e-mail.
DOMAIN=localhost
# "internal" (self-signed) or the e-mail address of your Let's Encrypt account.
TLS=internal
# Host folder mounted read-only at /data in the backend; users can register
# folders under /data (e.g. /data/projects). Default: the bundled ./sample-data.
LOCAL_DATA_DIR=./sample-data
# PyTorch build: cpu (default) or cu128 (NVIDIA; use docker-compose.gpu.yml).
TORCH_VARIANT=cpu
# Uvicorn workers. Keep 1: the indexing worker and the AI models live in the API process.
WORKERS=1

# ============================================================================
# Application
# ============================================================================

# "development" or "production" (docker-compose.yml forces production).
# Production refuses to start without strong secrets, QDRANT_API_KEY and REDIS_URL.
ENV=development

# Postgres application role and database (docker: created by deploy/postgres/initdb).
POSTGRES_USER=cogniseek
POSTGRES_DB=cogniseek
# [dev] SQLAlchemy URL used by the non-Docker backend (docker builds its own).
DATABASE_URL=postgresql://cogniseek:change-me@localhost:5432/cogniseek

# [dev] Qdrant host and port (docker: the "qdrant" service).
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Qdrant collections are <prefix>_text, _image, _audio, _video, _video_frames.
QDRANT_COLLECTION_PREFIX=cogniseek_v2
# ":memory:" = in-process Qdrant (tests); empty = QDRANT_HOST/PORT.
QDRANT_LOCATION=

# [dev] Redis for rate-limit counters; empty = in-memory (docker: the "redis" service).
REDIS_URL=

# JWT algorithm and access-token lifetime (minutes).
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limits (slowapi syntax). Login/register per client IP; search and OAuth per user.
AUTH_RATE_LIMIT=5/minute
SEARCH_RATE_LIMIT=60/minute
OAUTH_RATE_LIMIT=10/minute

# [dev] Browser origins allowed by CORS (docker: same origin, https://$DOMAIN).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# [dev] Public URL of the backend; OAuth callbacks are built from it.
# docker: https://$DOMAIN/api
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# [dev] Public URL of the frontend (OAuth returns here). docker: https://$DOMAIN
FRONTEND_URL=http://127.0.0.1:3000

# OAuth client files ([docker]: ./credentials is mounted read-only at /app/credentials).
GITHUB_OAUTH_CONFIG_PATH=credentials/github_oauth.json
GOOGLE_CLIENT_SECRET_PATH=credentials/client_secret.json
# Google redirect URI; register EXACTLY this value in the Google Cloud console.
# [dev] http://127.0.0.1:8000/platforms/google-drive/callback
# docker: https://<DOMAIN>/api/platforms/google-drive/callback (set automatically)
# GitHub OAuth app callback: <BACKEND_PUBLIC_URL>/platforms/github/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/platforms/google-drive/callback

# Connectors: skip files larger than this (MB); include forked / archived repos.
MAX_DOWNLOAD_MB=200
GITHUB_INCLUDE_FORKS=false
GITHUB_INCLUDE_ARCHIVED=false
# OCR at most this many pages per PDF (scanned or image-heavy pages only).
OCR_MAX_PAGES=20
# OCR device: auto (GPU when the CUDA build of Paddle is installed, requirements-gpu.txt), cpu or gpu.
OCR_DEVICE=auto
# Files indexed at once per job (1 = sequential), and the most files in flight.
INDEX_IO_WORKERS=4
INDEX_PREFETCH=8
# faster-whisper batched pipeline (0 = off: measured slower end-to-end, docs/perf/RESULTS.md).
WHISPER_BATCH_SIZE=0
# One lock for all GPU model calls (false: per-model locks, measured faster).
GPU_SERIALIZE=false
# Files never indexed (comma-separated base-name globs, case-insensitive).
INDEX_EXCLUDE_GLOBS=*.log,*.lock,*.min.js,*.map,*_log.txt,project_files.txt,package-lock.json,yarn.lock,poetry.lock

# Load all AI models at startup (true) or lazily on first use (false).
PRELOAD_MODELS=true
# [dev] Folder with Poppler binaries (empty = on PATH; the image includes Poppler).
POPPLER_PATH=

# [dev] Upload and temp folders (docker: /var/lib/cogniseek volume).
DATA_DIR=data
TEMP_DIR=temp
MAX_UPLOAD_MB=100
# Directories under which local folders may be registered (comma list).
# [dev] empty = the backend user's home directory. docker: /data (see LOCAL_DATA_DIR).
ALLOWED_LOCAL_ROOTS=

# Logs: "text" or "json" (empty = json in production, text in development).
LOG_FORMAT=
LOG_LEVEL=INFO
# GET /metrics for Prometheus (internal network only; Caddy never proxies it).
METRICS_ENABLED=true
