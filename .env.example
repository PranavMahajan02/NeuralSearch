# Copy to .env and fill in real values. .env is git-ignored; never commit it.

# "development" or "production". Production refuses to start without a strong JWT_SECRET_KEY.
ENV=development

# SQLAlchemy URL for Postgres (must match the POSTGRES_* values below when using docker compose).
DATABASE_URL=postgresql://cogniseek:change-me@localhost:5432/cogniseek
# Postgres container user (read by docker-compose.yml).
POSTGRES_USER=cogniseek
# Postgres container password (read by docker-compose.yml).
POSTGRES_PASSWORD=change-me
# Postgres database name (read by docker-compose.yml).
POSTGRES_DB=cogniseek

# Qdrant host name (localhost when running the backend outside docker).
QDRANT_HOST=localhost
# Qdrant HTTP port.
QDRANT_PORT=6333

# JWT signing key, at least 32 random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
# JWT signing algorithm.
JWT_ALGORITHM=HS256
# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
# Public URL of this backend (used to build OAuth callback URLs).
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# Public URL of the frontend.
FRONTEND_URL=http://localhost:3000

# Path to the GitHub OAuth app config JSON (client_id / client_secret).
GITHUB_OAUTH_CONFIG_PATH=credentials/github_oauth.json
# Path to the Google OAuth client secret JSON.
GOOGLE_CLIENT_SECRET_PATH=credentials/client_secret.json

# Folder for user data files.
DATA_DIR=data
# Folder for temporary downloads during indexing.
TEMP_DIR=temp
